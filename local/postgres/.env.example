# Local PostgreSQL for docker compose only. In AWS this is RDS, with passwords in Secrets Manager.
# Copy to .env; .env is never committed.
# Each *_DB_PASSWORD must match DB_PASSWORD in that service's .env.

POSTGRES_PASSWORD=change-me-postgres
USER_DB_PASSWORD=change-me-user-db
CATALOG_DB_PASSWORD=change-me-catalog-db
ORDER_DB_PASSWORD=change-me-order-db
