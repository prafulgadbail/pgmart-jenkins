# catalog-service settings. Copy to .env for docker compose; .env is never committed.
# In Kubernetes the first block becomes a ConfigMap, the second a Secret
# (filled from AWS Secrets Manager by External Secrets).

# ======================= ConfigMap =======================
# Database (RDS endpoint and sslmode=require in AWS)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=catalogdb
DB_USER=catalog_svc
DB_SSLMODE=disable

# ======================= Secret ==========================
# Must match CATALOG_DB_PASSWORD in local/postgres/.env
DB_PASSWORD=change-me-catalog-db
# Same value in all three services, at least 32 characters
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
# Same value in order-service (stock calls between the two)
INTERNAL_TOKEN=change-me-internal-token
