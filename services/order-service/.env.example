# order-service settings. Copy to .env for docker compose; .env is never committed.
# In Kubernetes the first block becomes a ConfigMap, the second a Secret
# (filled from AWS Secrets Manager by External Secrets).

# ======================= ConfigMap =======================
# Database (RDS endpoint and sslmode=require in AWS)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=orderdb
DB_USER=order_svc
DB_SSLMODE=disable

# catalog-service address (its Kubernetes Service name in the cluster)
CATALOG_URL=http://catalog-service:8080
# Store address used in email links, e.g. https://pgmart-jenkins.aws.prafulgadbail.online
STORE_URL=http://localhost:8080

# Email: Mailpit locally; SES in AWS (email-smtp.ap-south-1.amazonaws.com, 587, auth and STARTTLS on)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_AUTH=false
SMTP_STARTTLS=false
MAIL_FROM="PGMart <no-reply@pgmart.local>"

# Razorpay public key id (rzp_test_...); empty = Cash on Delivery only
RAZORPAY_KEY_ID=

# ======================= Secret ==========================
# Must match ORDER_DB_PASSWORD in local/postgres/.env
DB_PASSWORD=change-me-order-db
# Same value in all three services, at least 32 characters
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
# Same value in catalog-service
INTERNAL_TOKEN=change-me-internal-token
# SES SMTP credentials (empty for Mailpit)
SMTP_USERNAME=
SMTP_PASSWORD=
# Razorpay test mode: dashboard.razorpay.com > Test mode > API keys; webhook secret from the webhook you add
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
