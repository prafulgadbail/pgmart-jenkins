# user-service settings. Copy to .env for docker compose; .env is never committed.
# In Kubernetes the first block becomes a ConfigMap, the second a Secret
# (filled from AWS Secrets Manager by External Secrets).

# ======================= ConfigMap =======================
# Database (RDS endpoint and sslmode=require in AWS)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=userdb
DB_USER=user_svc
DB_SSLMODE=disable

# Login token lifetime
JWT_TTL=24h

# Email: Mailpit locally; SES in AWS (email-smtp.ap-south-1.amazonaws.com, 587, auth and STARTTLS on)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_AUTH=false
SMTP_STARTTLS=false
MAIL_FROM="PGMart <no-reply@pgmart.local>"

# Store admin, created when the service starts
ADMIN_EMAIL=admin@pgmart.local

# ======================= Secret ==========================
# Must match USER_DB_PASSWORD in local/postgres/.env
DB_PASSWORD=change-me-user-db
# Same value in all three services, at least 32 characters
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
# SES SMTP credentials (empty for Mailpit)
SMTP_USERNAME=
SMTP_PASSWORD=
# At least 8 characters
ADMIN_PASSWORD=change-me-admin
